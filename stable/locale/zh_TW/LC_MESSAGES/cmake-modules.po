msgid "CMake modules"
msgstr ""

#: ../../../cmake-modules.rst:5
msgid ""
"To facilitate the writing of ``CMakeLists.txt`` used to build CPython C/C++/"
"Cython extensions, **scikit-build** provides the following historical CMake "
"modules:"
msgstr ""

#: ../../../cmake-modules.rst:18
msgid "They can be included using ``find_package``:"
msgstr ""

#: ../../../cmake-modules.rst:20
msgid ""
"find_package(Cython REQUIRED)\n"
"find_package(NumPy REQUIRED)\n"
"find_package(PythonExtensions REQUIRED)\n"
"find_package(F2PY REQUIRED)"
msgstr ""

#: ../../../cmake-modules.rst:28
msgid "For more details, see the respective documentation of each modules."
msgstr ""

#: ../../../cmake-modules.rst:30
msgid "New code should not use these. The recommended replacements:"
msgstr ""

#: ../../../cmake-modules.rst:32
msgid "``Cython`` -> cython-cmake (on PyPI)"
msgstr ""

#: ../../../cmake-modules.rst:33
msgid "``NumPy`` -> FindPython with NumPy component (CMake built-in)"
msgstr ""

#: ../../../cmake-modules.rst:34
msgid "``PythonExtensions`` -> FindPython (CMake built-in)"
msgstr ""

#: ../../../cmake-modules.rst:35
msgid "``F2PY`` -> f2py-cmake (on PyPI)"
msgstr ""
