#: ../../../cmake-modules/NumPy.rst:2
msgid "NumPy"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:3
msgid ""
"Find the include directory for ``numpy/arrayobject.h`` as well as other "
"NumPy tools like ``conv-template`` and ``from-template``."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:6
msgid "This module sets the following variables:"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:8
msgid "``NumPy_FOUND``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:9
msgid "True if NumPy was found."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:10
msgid "``NumPy_INCLUDE_DIRS``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:11
msgid "The include directories needed to use NumPy."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:12
msgid "``NumPy_VERSION``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:13
msgid "The version of NumPy found."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:14
msgid "``NumPy_CONV_TEMPLATE_EXECUTABLE``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:15
msgid "Path to conv-template executable."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:16
msgid "``NumPy_FROM_TEMPLATE_EXECUTABLE``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:17
msgid "Path to from-template executable."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:19
msgid "The module will also explicitly define one cache variable:"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:21
msgid "``NumPy_INCLUDE_DIR``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:25
msgid ""
"To support NumPy < v1.15.0 where ``from-template`` and ``conv-template`` are "
"not declared as entry points, the module emulates the behavior of standalone "
"executables by setting the corresponding variables with the path to the "
"python interpreter and the path to the associated script. For example: ::"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindNumPy.cmake:30
msgid ""
"set(NumPy_CONV_TEMPLATE_EXECUTABLE /path/to/python /path/to/site-packages/"
"numpy/distutils/conv_template.py CACHE STRING \"Command executing conv-"
"template program\" FORCE)\n"
"\n"
"set(NumPy_FROM_TEMPLATE_EXECUTABLE /path/to/python /path/to/site-packages/"
"numpy/distutils/from_template.py CACHE STRING \"Command executing from-"
"template program\" FORCE)"
msgstr ""
