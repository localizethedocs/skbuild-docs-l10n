#: ../../../cmake-modules/Cython.rst:2
msgid "Cython"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:3
msgid "Find ``cython`` executable."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:5
msgid "This module will set the following variables in your project:"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:7
msgid "``CYTHON_EXECUTABLE``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:8
msgid "path to the ``cython`` program"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:10
msgid "``CYTHON_VERSION``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:11
msgid "version of ``cython``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:13
msgid "``CYTHON_FOUND``"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:14
msgid "true if the program was found"
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:16
msgid "For more information on the Cython project, see https://cython.org/."
msgstr ""

#: ../../../../skbuild/resources/cmake/FindCython.cmake:18
msgid ""
"*Cython is a language that makes writing C extensions for the Python "
"language as easy as Python itself.*"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:3
msgid "The following functions are defined:"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:7
msgid ""
"Create a custom rule to generate the source code for a Python extension "
"module using cython."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:10
msgid "add_cython_target(<Name> [<CythonInput>]"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:11
msgid "[EMBED_MAIN] [C | CXX] [PY2 | PY3] [OUTPUT_VAR <OutputVar>])"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:16
msgid ""
"``<Name>`` is the name of the new target, and ``<CythonInput>`` is the path "
"to a cython source file.  Note that, despite the name, no new targets are "
"created by this function.  Instead, see ``OUTPUT_VAR`` for retrieving the "
"path to the generated source for subsequent targets."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:21
msgid ""
"If only ``<Name>`` is provided, and it ends in the \".pyx\" extension, then "
"it is assumed to be the ``<CythonInput>``.  The name of the input without "
"the extension is used as the target name.  If only ``<Name>`` is provided, "
"and it does not end in the \".pyx\" extension, then the ``<CythonInput>`` is "
"assumed to be ``<Name>.pyx``."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:27
msgid ""
"The Cython include search path is amended with any entries found in the "
"``INCLUDE_DIRECTORIES`` property of the directory containing the "
"``<CythonInput>`` file.  Use ``include_directories`` to add to the Cython "
"include search path."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:32
msgid "Options:"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:34
msgid "``EMBED_MAIN``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:35
msgid ""
"Embed a main() function in the generated output (for stand-alone "
"applications that initialize their own Python runtime)."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:38
msgid "``C | CXX``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:39
msgid ""
"Force the generation of either a C or C++ file.  By default, a C file is "
"generated, unless the C language is not enabled for the project; in this "
"case, a C++ file is generated by default."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:43
msgid "``PY2 | PY3``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:44
msgid ""
"Force compilation using either Python-2 or Python-3 syntax and code "
"semantics.  By default, Python-2 syntax and semantics are used if the major "
"version of Python found is 2.  Otherwise, Python-3 syntax and semantics are "
"used."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:49
msgid "``OUTPUT_VAR <OutputVar>``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:50
msgid ""
"Set the variable ``<OutputVar>`` in the parent scope to the path to the "
"generated source file.  By default, ``<Name>`` is used as the output "
"variable name."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:54
msgid "Defined variables:"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:56
msgid "``<OutputVar>``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:57
msgid "The path of the generated source file."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:59
msgid "Cache variables that affect the behavior include:"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:61
msgid "``CYTHON_ANNOTATE``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:62
msgid "Whether to create an annotated .html file when compiling."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:64
msgid "``CYTHON_FLAGS``"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:65
msgid "Additional flags to pass to the Cython compiler."
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:68
msgid "Example usage"
msgstr ""

#: ../../../../skbuild/resources/cmake/UseCython.cmake:70
msgid ""
"find_package(Cython)\n"
"\n"
"# Note: In this case, either one of these arguments may be omitted; their\n"
"# value would have been inferred from that of the other.\n"
"add_cython_target(cy_code cy_code.pyx)\n"
"\n"
"add_library(cy_code MODULE ${cy_code})\n"
"target_link_libraries(cy_code ...)"
msgstr ""
