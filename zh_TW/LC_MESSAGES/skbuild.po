#: ../../../skbuild.rst:2
msgid "skbuild package"
msgstr "skbuild 軟體包"

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/__init__.py:docstring
#: of skbuild:1
msgid ""
"scikit-build is an improved build system generator for CPython C extensions."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/__init__.py:docstring
#: of skbuild:3
msgid ""
"This module provides the *glue* between the setuptools Python module and "
"CMake. The build backend is provided by scikit-build-core's setuptools "
"plugin."
msgstr ""

#: ../../../skbuild.rst:10
msgid "Submodules"
msgstr "子模組"

#: ../../../skbuild.rst:13
msgid "skbuild.exceptions module"
msgstr "skbuild.exceptions 模組"

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/exceptions.py:docstring
#: of skbuild.exceptions:1
msgid "This module defines exceptions commonly used in scikit-build."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/exceptions.py:docstring
#: of skbuild.exceptions:3
msgid ""
"``SKBuildError`` is now an alias of the setuptools ``SetupError`` raised by "
"the scikit-build-core setuptools plugin, kept so that existing ``except "
"SKBuildError`` clauses continue to work."
msgstr ""

#: ../../../skbuild.rst:21
msgid "Deprecated shims"
msgstr ""

#: ../../../skbuild.rst:23
msgid ""
"These modules exist only for compatibility with scikit-build <1.0 and warn "
"with ``DeprecationWarning`` on import."
msgstr ""

#: ../../../skbuild.rst:27
msgid "skbuild.cmaker module"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/cmaker.py:docstring
#: of skbuild.cmaker:1
msgid "Compatibility shim for ``skbuild.cmaker``."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/cmaker.py:docstring
#: of skbuild.cmaker:3
msgid ""
"scikit-build 1.0 builds on scikit-build-core and no longer ships the "
"``CMaker`` class. Only :func:`get_cmake_version` is kept, since downstream "
"``setup.py`` files use it to gate on the installed CMake version."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/cmaker.py:docstring
#: of skbuild.cmaker.get_cmake_version:1
msgid ""
"Return the version of the given (or first found) CMake, e.g. ``\"3.14.4\"``."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/cmaker.py:docstring
#: of skbuild.cmaker.get_cmake_version:3
msgid ""
"With no argument, searches the way scikit-build-core does: the ``cmake`` "
"PyPI package if installed, then ``cmake3`` and ``cmake`` on PATH. Pre-"
"release suffixes are dropped (``3.30.0-rc1`` reports as ``3.30.0``)."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/cmaker.py:docstring
#: of skbuild.cmaker.get_cmake_version:7
msgid "Raises :class:`skbuild.exceptions.SKBuildError` if CMake cannot be run."
msgstr ""

#: ../../../skbuild.rst:33
msgid "skbuild.constants module"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/constants.py:docstring
#: of skbuild.constants:1
msgid "Compatibility shim for ``skbuild.constants``."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/constants.py:docstring
#: of skbuild.constants:3
msgid ""
"scikit-build 1.0 builds on scikit-build-core and no longer implements this "
"module. Two helpers downstream ``setup.py`` files use are kept: :func:"
"`skbuild_plat_name` (derives a wheel platform tag) and :func:"
"`CMAKE_INSTALL_DIR` (points at the CMake install staging directory, so a "
"plain ``setuptools.Extension`` can compile against CMake-installed headers "
"and libraries). The other classic path helpers (``CMAKE_BUILD_DIR``, "
"``SKBUILD_DIR``, and friends) described the old ``_skbuild/`` layout and are "
"not provided."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/constants.py:docstring
#: of skbuild.constants.CMAKE_INSTALL_DIR:1
msgid ""
"Directory where CMake installs files before setuptools merges them into the "
"wheel."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/constants.py:docstring
#: of skbuild.constants.CMAKE_INSTALL_DIR:4
msgid ""
"scikit-build-core's setuptools backend stages the CMake install under "
"setuptools' ``build_temp`` and runs CMake before compiling plain "
"``setuptools.Extension`` modules, as classic scikit-build did. Limits: "
"command-line overrides such as ``--build-temp`` are not visible here, and "
"editable installs do not populate this directory."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/constants.py:docstring
#: of skbuild.constants.skbuild_plat_name:1
msgid ""
"Platform name, e.g. ``macosx-11.0-arm64``, ``linux-x86_64``, ``win-amd64``."
msgstr ""

#: ../../../skbuild.rst:39
msgid "skbuild.setuptools_wrap module"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/setuptools_wrap.py:docstring
#: of skbuild.setuptools_wrap:1
msgid "Compatibility shim for ``skbuild.setuptools_wrap``."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/setuptools_wrap.py:docstring
#: of skbuild.setuptools_wrap:3
msgid ""
"scikit-build 1.0 builds on scikit-build-core, which does not implement the "
"classic install-classification pipeline this module drove. Nothing is "
"exported. The module exists only so a bare ``import skbuild."
"setuptools_wrap`` (some projects keep one for historical reasons) still "
"succeeds; any attribute access raises :class:`AttributeError`, since scikit-"
"build-core has no equivalent hook to monkeypatch. Port to scikit-build-core "
"APIs."
msgstr ""

#: ../../../skbuild.rst:44
msgid "skbuild.utils module"
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/utils.py:docstring
#: of skbuild.utils:1
msgid "Compatibility shim for ``skbuild.utils``."
msgstr ""

#: ../../../../../../.conda/lib/python3.13/site-packages/skbuild/utils.py:docstring
#: of skbuild.utils:3
msgid ""
"scikit-build 1.0 builds on scikit-build-core and no longer ships these path "
"and directory helpers. Nothing is exported. The module exists only so a bare "
"``import skbuild.utils`` still succeeds; any attribute access raises :class:"
"`AttributeError`. Use scikit-build-core APIs, or ``pathlib``/``os`` for the "
"path helpers."
msgstr ""
